{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "paths": {
            "@v-viewer/core/*": ["./packages/core/src/*"],
            "@v-viewer/race-common/*": ["./packages/race-common/*"],
            "@v-viewer/dogs6/*": ["./packages/dogs6/src/*"],
            "*": ["./node_modules/*"]
        }
    },
    "references": [{
